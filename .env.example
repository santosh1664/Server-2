APP_ENV=development
API_KEY=replace-with-a-long-random-secret
CAPTCHA_DEMO_ENABLED=false
DEMO_CHALLENGE_TTL_SECONDS=60
DEMO_MAX_ATTEMPTS=3
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SECONDS=25

# Google reCAPTCHA server-side verification
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=example.com,www.example.com
RECAPTCHA_EXPECTED_ACTION=
RECAPTCHA_MINIMUM_SCORE=0.5

# hCaptcha server-side verification
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITEKEY=
HCAPTCHA_ALLOWED_HOSTNAMES=example.com,www.example.com

# Cloudflare Turnstile server-side verification
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=example.com,www.example.com
TURNSTILE_EXPECTED_ACTION=

PROVIDER_VERIFY_TIMEOUT_SECONDS=8

REJEKT_CALLBACK_URL=
REJEKT_CALLBACK_SECRET=
